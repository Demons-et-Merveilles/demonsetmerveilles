{% extends 'base.html.twig' %}

{% block titre %}Connexion - Démons et Merveilles{% endblock %}

{% block contenu %}
<div class="div-centre pancarte" style="flex-direction: column;">
    <h1 class="titre"> Espace administration </h1>

    {% if erreur %}
    <p class="contenu">❌ Identifiant ou mot de passe incorrect.</p>
    {% endif %}

    <form method="post" class="formulaire-login">
        <label for="identifiant">Identifiant</label>
        <input type="text" id="identifiant" name="_username" value="{{ dernier_identifiant }}"
               autocomplete="username" required autofocus>

        <label for="mot-de-passe">Mot de passe</label>
        <input type="password" id="mot-de-passe" name="_password" autocomplete="current-password" required>

        {# Protection CSRF vérifiée par le firewall #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="button">Se connecter</button>
    </form>
</div>
{% endblock %}
