{% extends 'base.html.twig' %}

{% block titre %}JDRs et Invités - Démons et Merveilles{% endblock %}

{% block contenu %}
<div class="card-container">
    {# Les cartes viennent de la base de données (gérées dans /admin/jdrs) #}
    {% for jdr in jdrs %}
        {{ include('_carte.html.twig', {jdr: jdr}) }}
    {% else %}
        <p class="div-centre">Aucun JDR n'est publié pour le moment.</p>
    {% endfor %}
</div>
{% endblock %}
