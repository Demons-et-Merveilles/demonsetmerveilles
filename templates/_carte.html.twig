{#
    Carte de JDR / invité.
    Variables :
      - jdr        : entité PublishedJdr
      - impression : true pour la version imprimable (sans lien ni horaire, jamais "double")
    Les textes sont échappés par Twig ; les retours à la ligne de la description
    sont conservés par le CSS (white-space: pre-line).
#}
{% set impression = impression|default(false) %}
{% set taille = (not impression and jdr.format.value == 'double') ? 'Double' : '' %}
{% set nomMj = jdr.masteringName %}
{% set maitrise = jdr.type.value == 'jdr' ? (nomMj ? 'Masterisé par ' ~ nomMj : '') : nomMj %}

<div class="card{{ taille }} {{ jdr.type.value }}">
    {% if jdr.image %}
        <div class="card-image-container">
            <img class="card-image" src="{{ asset(jdr.image) }}" alt="Illustration de {{ jdr.title }}">
        </div>
        <hr class="card-hr"/>
    {% endif %}

    <div class="card-content">
        <span class="card-title">{{ jdr.title }}</span>
        <span class="card-description">{{ jdr.description }}</span>
        <span class="card-mastering">
            <h3>
                {{ maitrise }}
                {% if not impression and jdr.link %}
                    <a href="{{ jdr.link }}" style="color:lightblue"> {{ jdr.linkLabel }} {{ jdr.link }} </a>
                {% endif %}
            </h3>
            {% if not impression and jdr.schedule %}
                <h3>{{ jdr.schedule }}</h3>
            {% endif %}
        </span>
    </div>
</div>
